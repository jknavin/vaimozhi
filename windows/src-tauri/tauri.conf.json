{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VAIMOZHI",
  "version": "0.1.0",
  "identifier": "app.vaimozhi.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VAIMOZHI – வாய்மொழி",
        "width": 1080,
        "height": 740,
        "minWidth": 720,
        "minHeight": 560,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "publisher": "VAIMOZHI",
    "shortDescription": "Offline voice typing for Tamil, English and Tanglish",
    "license": "MIT",
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["English"] }
    }
  }
}
